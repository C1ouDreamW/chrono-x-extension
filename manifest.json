{
  "manifest_version": 3,
  "name": "Chrono X · 双时区时间",
  "short_name": "Chrono X",
  "description": "为 X/Twitter 帖子展示你的本地时间和可核实的作者时区；支持手动校正、主页与悬浮卡片位置识别。",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "action": {
    "default_title": "Chrono X · 双时区时间",
    "default_popup": "popup/popup.html",
    "default_icon": {"16":"icons/icon16.png", "32":"icons/icon32.png"}
  },
  "icons": {"16":"icons/icon16.png", "32":"icons/icon32.png", "48":"icons/icon48.png", "128":"icons/icon128.png"},
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*", "https://www.x.com/*", "https://www.twitter.com/*"],
    "css": ["src/content.css"],
    "js": ["shared/timezones.js", "src/content.js"],
    "run_at": "document_idle"
  }]
}
